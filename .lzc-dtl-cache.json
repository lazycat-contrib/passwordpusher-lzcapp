{
  "name": "Password Pusher",
  "package": "cloud.lazycat.app.password-pusher",
  "description": "Password Pusher 是一个用来分享密码、文本甚至文件的工具，但它和普通的聊天软件不一样！它会生成一个带加密的“一次性链接”，对方只能在规定的时间内或有限的查看次数中访问。一旦次数用完或时间到期，内容会自动消失，最大限度保护你的隐私。",
  "homepage": "https://github.com/pglombardo/PasswordPusher",
  "author": "pglombardo",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "password-pusher",
  "version": "1.5.3",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "pwpush_5100_5100": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_docker.io_pglombardo_pwpush_latest": {
    "originalImage": "docker.io/pglombardo/pwpush:latest",
    "pushTarget": "none"
  },
  "pwpush_volume_/opt/PasswordPusher/data_action": "emptyDir",
  "pwpush_volume_/opt/PasswordPusher/data_location": "app_data"
}
